from datetime import date

atual = date.today().year

nascimento = int(input('Ano de nascimento: '))

idade = atual - nascimento

print(f'Quem nasceu em {nascimento} tem {idade} em {atual}')

if idade == 18:
    print(f'Você tem que se alistar \033[1;31mIMEDIATAMENTE \033[m')
elif idade < 18:
    saldo = 18 - idade
    print(f'Você ainda não tem 18 anos, ainda faltam {saldo} para o alistamento')
elif idade > 18:
    saldo = idade - 18
    print(f'Você deveria ter se alistado a {saldo} anos.')
